# Copy this file to .env and fill in real values.
# .env is listed in .gitignore and will never be committed. Never put real keys in THIS file.

# Optional -- EcoNexus Copilot LLM mode. Get a free key at https://console.groq.com
# Without it the Copilot still answers from the live platform data with its built-in engine;
# the key adds free-form LLM phrasing on top of the same numbers.
GROQ_API_KEY=

# Optional -- override the Groq model, endpoint or timeout
# GROQ_MODEL=llama-3.1-8b-instant
# GROQ_URL=https://api.groq.com/openai/v1/chat/completions
# GROQ_TIMEOUT_S=20

# Optional -- Google Maps JavaScript API key for the live basemap. A browser key is visible to
# anyone who opens the page: restrict it to the Maps JavaScript API and your HTTP referrers.
# (static/js/config.js can hold a key too; that one is used when the dashboard is opened from disk.)
GOOGLE_MAPS_API_KEY=

# Optional -- Flask server settings (defaults shown)
# ECONEXUS_HOST=127.0.0.1
# ECONEXUS_PORT=8000
# ECONEXUS_DEBUG=false
# ECONEXUS_OPEN_BROWSER=true
# ECONEXUS_CORS_ORIGINS=null,http://localhost:8000,http://127.0.0.1:8000
